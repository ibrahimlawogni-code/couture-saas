NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxx

# Purge nocturne des ateliers abandonnes (voir README).
# Necessaires en production, facultatifs en developpement.
SUPABASE_SERVICE_ROLE_KEY=xxxxx
CRON_SECRET=xxxxx

# « Continuer avec Google » sur les ecrans d'acces. A poser a 1 seulement
# une fois le fournisseur configure dans Supabase, sinon le bouton
# s'affiche et echoue (voir README).
NEXT_PUBLIC_AUTH_GOOGLE=

# Encaissement des abonnements par SASPay. Aucune des deux ne porte le
# prefixe NEXT_PUBLIC_ : elles autorisent a encaisser et n'ont rien a faire
# dans le navigateur.
#
# La cle secrete se prend sur app.saspay.me. Commencer par sk_test_.
SASPAY_SECRET_KEY=
# Donne une seule fois, a la creation du webhook sur app.saspay.me.
SASPAY_WEBHOOK_SECRET=
